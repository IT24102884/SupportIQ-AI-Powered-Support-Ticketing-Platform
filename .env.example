# Database Configuration (Defaults to SQLite for instant local execution)
DATABASE_URL=sqlite:///./tickets.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:password123@localhost:5432/support_desk

# Security
JWT_SECRET=super-secret-key-support-ai-change-in-prod-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys (Optional - Intelligent deterministic heuristic fallback runs if omitted)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ChromaDB Persistent Storage
CHROMA_PERSIST_DIR=./chroma_data

